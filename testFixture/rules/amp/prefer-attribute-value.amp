%%[
/* ── Rule: sfmc/amp-prefer-attribute-value ─────────────────────────────────────
   Custom personalization strings (bare or bracketed) should be wrapped in
   AttributeValue() to avoid send-aborting errors when the attribute is absent.
   Known system personalization strings (e.g. firstname, subscriberkey) are
   exempt in either form.
   ─────────────────────────────────────────────────────────────────────────── */

/* ✅ ACCEPTED — attribute access wrapped in AttributeValue() */
VAR @firstName
SET @firstName = AttributeValue("CustomerTier")

/* ✅ ACCEPTED — known system personalization string, bare and bracketed */
VAR @key
SET @key = _subscriberkey
VAR @email
SET @email = [emailaddr]

/* ❌ FAIL — bare custom attribute used directly as a value */
VAR @tier
SET @tier = CustomerTier

/* ❌ FAIL — bracketed custom attribute used directly as a value */
VAR @segment
SET @segment = [Customer Segment]
]%%
